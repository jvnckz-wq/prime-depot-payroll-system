// ============================================================================
// PRIME DEPOT HARDWARE & CONSTRUCTION SUPPLY
// Payroll Management System with Biometrics Attendance Importing
// Database schema — PostgreSQL (Neon)
//
// Money is stored as Decimal(12,2), never Float. Floating-point arithmetic
// introduces rounding drift, which is unacceptable when the numbers are
// somebody's salary.
// ============================================================================

// Prisma 7 notes:
//  - `output` is now REQUIRED; the client is no longer generated into
//    node_modules by default.
//  - The datasource block no longer accepts `url`. The connection string for
//    migrations lives in prisma.config.ts; the running app passes a driver
//    adapter instead. That is why this block only declares the provider.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN // Operations Head — full access
  CHECKER // Delivery logging only
}

/// Job positions. Position ALONE decides which payroll module an employee
/// belongs to — DRIVER and PAHINANTE are paid piece-rate (pakyawan) through
/// Truck Payroll, everyone else runs through Staff Payroll. There is
/// deliberately no separate "employee type" column: two fields meaning the
/// same thing can disagree, and then nobody knows which one to trust.
enum Position {
  OPERATIONS_HEAD
  ADMINISTRATIVE_STAFF
  /// DEPRECATED — kept only so existing rows stay valid. The early call time
  /// turned out not to be a separate job at all: it is the same administrative
  /// staff member reporting early on certain days. That belongs on the person
  /// (see earlyShiftDays below), not in their job title. Not offered when
  /// registering a new employee.
  SECRETARY_SPECIAL_SHIFT
  CHECKER
  DRIVER
  PAHINANTE
  /// Added Jul 2026 — office-staff positions taken from the client's actual
  /// payroll sheet. All run through Staff Payroll (none are crew), so no
  /// crew-detection or call-time logic changes. Appended at the end to match
  /// Postgres ALTER TYPE ADD VALUE ordering.
  ADMINISTRATIVE_ASSISTANT
  COMMUNICATIONS_OFFICER_II
  JUNIOR_SECRETARY
  JOB_ORDER
  TRAINEE
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum LoanType {
  LOAN
  CASH_ADVANCE // "bale"
}

/// Ledger entries are typed so a balance can be derived by summing them.
/// The balance is never stored as a mutable column — see the Loan model.
enum LedgerEntryType {
  GRANT // money released to the employee (increases balance)
  DEDUCTION // money withheld from pay (decreases balance)
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum PayrollType {
  STAFF // semi-monthly, attendance-based
  TRUCK // pakyawan, delivery-based
}

/// What an AuditLog row records. Kept as an enum rather than free text so a
/// typo cannot quietly create a category nobody ever queries for.
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_THROTTLED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_CREATED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  SESSIONS_REVOKED
  PAYROLL_FINALIZED
  PAYROLL_UNFINALIZED
  DELIVERY_VOIDED
  DELIVERY_UNVOIDED
  CREW_RATES_UPDATED
}

// ============================================================================
// ACCESS
// ============================================================================

/// System accounts. There is no public registration — the Operations Head
/// creates every account from Settings. Passwords are stored hashed only.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  /// Optional recovery email. Only the Operations Head sets one; it is where a
  /// "forgot password" reset code is sent. Checkers do not self-reset — the
  /// admin resets their password directly.
  email        String?
  /// Profile picture, stored as a base64 data URL rather than a file.
  ///
  /// With a handful of accounts this is the pragmatic choice: no storage
  /// service to sign up for, no extra credential to protect, no broken links
  /// if that service goes away. The image is resized to 128px in the browser
  /// before upload and capped server-side, so a row stays small. This would
  /// be the wrong choice for thousands of users; it is the right one for
  /// three.
  avatar       String?
  role         Role     @default(CHECKER)
  /// Disabled rather than deleted when someone leaves. Deleting the account
  /// would orphan the record of who logged each delivery; disabling keeps the
  /// history intact while blocking any further sign-in.
  isActive     Boolean  @default(true)
  /// Set when an account is created or its password is reset by the admin.
  /// The user is forced to choose their own password before doing anything
  /// else, so a temporary password handed over verbally never stays in use.
  mustChangePassword Boolean @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loggedDeliveries Delivery[] @relation("DeliveryLoggedBy")
  voidedDeliveries Delivery[] @relation("DeliveryVoidedBy")
  sessions         Session[]
  auditLogs        AuditLog[]
  passwordResets   PasswordReset[]

  @@map("users")
}

/// A short-lived code emailed to the Operations Head to reset a forgotten
/// password. The code itself is never stored — only its SHA-256 hash — so a
/// leaked database does not hand over usable codes. A row is single-use
/// (usedAt), expires quickly (expiresAt), and counts wrong guesses (attempts)
/// so a six-digit code cannot be brute-forced.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// Server-side sessions.
///
/// The cookie holds a random token; this table stores only its SHA-256 hash,
/// so a database leak does not hand over usable sessions. Sessions live in the
/// database rather than in a signed token because they must be revocable — when
/// the admin disables an account, that person has to lose access immediately,
/// not whenever their token happens to expire.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Failed sign-in counter, keyed on source IP + username.
///
/// This used to be a plain Map in the login route's module scope. That resets
/// on every cold start, and each serverless instance keeps its own tally, so in
/// practice an attacker rarely met the same counter twice — it looked like a
/// throttle without being one. Here it is shared by every instance and survives
/// redeploys.
///
/// Keyed on the PAIR on purpose. Throttling by username alone would let anyone
/// lock a known user out for fifteen minutes just by spamming wrong passwords
/// for their name — which, with a single Operations Head account, is a remote
/// off switch for the whole business. Pairing it with the IP means a guesser
/// only ever throttles themselves.
model LoginAttempt {
  id      String   @id @default(cuid())
  /// "<ip>|<username>".
  key     String   @unique
  count   Int      @default(1)
  /// Start of the current window. Once this is older than the window length,
  /// the record is treated as expired and counting restarts from one.
  firstAt DateTime @default(now())
  lastAt  DateTime @default(now())

  @@index([firstAt])
  @@map("login_attempts")
}

/// Security and money events, append-only.
///
/// Some of this was already implicit — Delivery.voidedById, Delivery.loggedById,
/// User.lastLoginAt — but scattered across tables and impossible to read as a
/// sequence. A payroll system needs one place that answers "who did what, when",
/// both for ordinary disputes about a payslip and because RA 10173 expects a
/// controller to be able to show who touched personal data.
///
/// Nothing here cascades on delete: the trail has to outlive the account it
/// describes, so actorId goes null and actorLabel keeps the name.
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  /// Null for a failed sign-in, where there may be no real account behind the
  /// attempt at all.
  actorId    String?
  /// The username as it read at the time. Kept as text so the entry still makes
  /// sense after a rename, and so a failed login can name what was tried.
  actorLabel String?
  /// What was acted on — an account id, a cutoff label, a delivery id.
  targetType String?
  targetId   String?
  /// Short human-readable context: the void reason, the cutoff released.
  detail     String?
  ip         String?
  createdAt  DateTime    @default(now())

  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ============================================================================
// EMPLOYEES
// ============================================================================

/// One row per person on the payroll.
///
/// `id` is the employee's ID number as printed on their record AND as
/// registered on the biometric scanner — that shared value is what links an
/// imported attendance row to a person. It is entered manually at
/// registration rather than generated, because the scanner assigns it.
model Employee {
  id              String         @id
  name            String
  position        Position
  dailyRate       Decimal        @db.Decimal(12, 2)
  /// Basis for SSS / PhilHealth / Pag-IBIG bracket lookups.
  declaredSalary  Decimal        @default(0) @db.Decimal(12, 2)
  status          EmployeeStatus @default(ACTIVE)

  // Statutory contribution switches — not every employee is enrolled in all.
  sssEnrolled     Boolean        @default(false)
  philhealthEnrolled Boolean     @default(false)
  pagibigEnrolled Boolean        @default(false)
  /// Voluntary Pag-IBIG MP2 savings, on top of the mandatory contribution.
  mp2Amount       Decimal        @default(0) @db.Decimal(12, 2)
  /// Per-employee default "Other Allowances" for staff payroll. Varies per
  /// person (transport, meal, etc.), so it lives on the employee rather than
  /// hardcoded. A per-cutoff override lands with the Finalize feature.
  otherAllowance  Decimal        @default(0) @db.Decimal(12, 2)
  /// Annual paid-leave allotment (Service Incentive Leave). Days taken are
  /// marked on attendance as "On Leave"; unused credits are monetised in the
  /// employee's final pay. Defaults to 5, the statutory minimum, per person.
  leaveCredits    Int            @default(5)

  // Personal information — required by the client spec for company records.
  // Deliberately never printed on payslips; the client asked to keep those
  // clean. Also the reason this table needs care under RA 10173.
  address         String?
  contactNumber   String?
  birthdate       DateTime?      @db.Date
  /// Needed to prorate 13th-month pay for anyone who did not work the full year.
  dateHired       DateTime?      @db.Date

  /// Days this person is required to report early. Empty means no early
  /// requirement at all; one day, several days, or all seven are equally
  /// valid. Modelled per-person rather than as a job title because the same
  /// administrative staff member may be early on Saturdays and normal the
  /// rest of the week.
  earlyShiftDays  Weekday[]
  /// The early call time for those days, as "HH:MM" on a 24-hour clock.
  /// Stored as text on purpose: a time of day has no date, and forcing it into
  /// a timestamp drags a date and a timezone along with it, which is a
  /// reliable source of off-by-one-hour bugs. Null falls back to 06:00.
  earlyShiftTime  String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  attendance      Attendance[]
  loans           Loan[]
  payslips        Payslip[]
  drivenDeliveries  Delivery[]   @relation("DeliveryDriver")
  helper1Deliveries Delivery[]   @relation("DeliveryHelper1")
  helper2Deliveries Delivery[]   @relation("DeliveryHelper2")

  @@index([position])
  @@index([status])
  @@map("employees")
}

// ============================================================================
// ATTENDANCE
// ============================================================================

/// One row per employee per day, imported from the biometric .xls export.
///
/// The import is deliberately "dumb": it records everyone — office staff and
/// truck crew alike — and makes no decision about pay. Each payroll module
/// then reads what it needs. Staff Payroll uses days present, tardiness, and
/// overtime; Truck Payroll uses ONLY tardiness, because crew daily rates are
/// fixed regardless of hours.
model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  date          DateTime @db.Date
  timeIn        DateTime?
  timeOut       DateTime?

  /// Minutes late, computed against the position's call time
  /// (6:00 AM special shift, 6:30 AM driver/helper/checker, 6:40 AM standard).
  tardinessMins Int      @default(0)
  overtimeMins  Int      @default(0)
  isAbsent      Boolean  @default(false)
  /// A paid day off. Counts toward the employee's pay like a present day, but
  /// is tracked separately from worked days and from absences.
  isLeave       Boolean  @default(false)

  /// A missing time-in is penalised 30 minutes; a missing time-out is assumed
  /// to be 5:00 PM so no accidental overtime is credited. Flagged so the
  /// Operations Head can see which rows were filled in by rule, not by scan.
  isAssumedIn   Boolean  @default(false)
  isAssumedOut  Boolean  @default(false)
  /// Manual corrections are permitted (brownouts, scanner failures) but are
  /// always marked, so an edited row is never mistaken for a raw scan.
  isManualEdit  Boolean  @default(false)
  editNote      String?

  importBatchId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

/// One row per uploaded biometric file — the "Import History" tab.
model ImportBatch {
  id            String       @id @default(cuid())
  filename      String
  importedAt    DateTime     @default(now())
  periodStart   DateTime?    @db.Date
  periodEnd     DateTime?    @db.Date
  totalRows     Int          @default(0)
  mappedRows    Int          @default(0)
  unmappedRows  Int          @default(0)
  status        ImportStatus @default(PROCESSING)
  errorMessage  String?

  attendance    Attendance[]
  unmappedLogs  UnmappedLog[]

  @@map("import_batches")
}

/// Scanner rows whose ID doesn't match any registered employee. Held here
/// instead of being dropped, so the Operations Head can register the person
/// and then resolve the backlog — this is the dashboard's "Unmapped IDs" count.
model UnmappedLog {
  id            String      @id @default(cuid())
  importBatchId String
  biometricId   String
  biometricName String?
  date          DateTime    @db.Date
  timeIn        DateTime?
  timeOut       DateTime?
  isResolved    Boolean     @default(false)
  resolvedAt    DateTime?

  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([isResolved])
  @@map("unmapped_logs")
}

// ============================================================================
// FLEET & DELIVERIES (PAKYAWAN)
// ============================================================================

/// The fleet — vehicles only.
///
/// A truck deliberately carries NO crew. Nothing in the client interview says
/// a driver belongs to a particular truck, so the system does not record one:
/// modelling a "usual driver" would invent a relationship the business never
/// described, and the column alone would teach everyone the wrong idea. Who
/// drove what is a fact of each delivery, and lives on that record.
model Truck {
  id             String     @id // e.g. "TRK-01"
  vehicle        String // e.g. "Blue MD"
  plateNumber    String
  isActive       Boolean    @default(true)

  deliveries     Delivery[]

  @@map("trucks")
}

/// One trip. The crew is recorded per delivery — driver included — because
/// crew composition is decided on the day, not by a standing assignment.
/// This is why `driverId` lives here and is not read from Truck.
model Delivery {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  truckId      String
  driverId     String
  helper1Id    String?
  helper2Id    String?

  /// Trip number within that truck's day. Drives the palima bonus, which is
  /// awarded per head once a truck reaches the trip threshold.
  sequenceNo   Int
  customerName String?
  address      String

  /// Specific address / landmark (purok, sitio, gate colour, "beside the
  /// chapel"). `address` stays the broad area that drives double-rate matching;
  /// this carries the detail a driver actually navigates by.
  landmark     String?
  /// Receiver's contact number, so the driver can call when near or lost.
  contactNo    String?

  /// True when the destination falls in a double-rate ("doble") area. Set
  /// automatically from the known area list, but overridable — the checker
  /// can mark a trip doble even if the address text doesn't match.
  isDouble     Boolean  @default(false)
  matchedArea  String?

  loggedById   String?

  /// Corrections are voids, not deletions. A mistyped quantity stays visible
  /// with the person and reason attached, so the Operations Head can see that
  /// something was corrected and by whom — the same append-only principle the
  /// loan ledger uses. A voided trip is excluded from earnings but never
  /// disappears from the record.
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  truck        Truck          @relation(fields: [truckId], references: [id])
  driver       Employee       @relation("DeliveryDriver", fields: [driverId], references: [id])
  helper1      Employee?      @relation("DeliveryHelper1", fields: [helper1Id], references: [id], onDelete: SetNull)
  helper2      Employee?      @relation("DeliveryHelper2", fields: [helper2Id], references: [id], onDelete: SetNull)
  loggedBy     User?          @relation("DeliveryLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)
  voidedBy     User?          @relation("DeliveryVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  items        DeliveryItem[]

  @@unique([truckId, date, sequenceNo])
  @@index([date])
  @@index([driverId])
  @@index([voidedAt])
  @@map("deliveries")
}

/// Line items within a trip. The peso amounts are frozen at the moment of
/// logging rather than recomputed from RateItem later — if the rate table is
/// edited next month, past payslips must not silently change.
model DeliveryItem {
  id            String   @id @default(cuid())
  deliveryId    String
  rateItemId    String?
  itemName      String
  unit          String
  quantity      Decimal  @db.Decimal(12, 2)
  driverAmount  Decimal  @db.Decimal(12, 2)
  helperAmount  Decimal  @db.Decimal(12, 2)

  delivery      Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rateItem      RateItem? @relation(fields: [rateItemId], references: [id], onDelete: SetNull)

  @@map("delivery_items")
}

/// The piece-rate table ("VALUES" sheet). Editable by the Operations Head.
model RateItem {
  id                  String         @id @default(cuid())
  itemName            String
  unit                String
  driverRate          Decimal        @db.Decimal(12, 2)
  helperRate          Decimal        @db.Decimal(12, 2)
  driverRateDouble    Decimal        @db.Decimal(12, 2)
  helperRateDouble    Decimal        @db.Decimal(12, 2)
  isActive            Boolean        @default(true)

  deliveryItems       DeliveryItem[]

  @@unique([itemName, unit])
  @@map("rate_items")
}

/// Pakyawan pay constants for delivery crew.
///
/// These were four hardcoded numbers in src/data/seed.js. That put them in the
/// browser bundle — so the figures a payslip was built from were whatever the
/// client had loaded — and it meant changing a rate needed a redeploy. Per-item
/// rates already lived in RateItem; the daily minimums and the bonus belong in
/// the database for exactly the same reasons.
///
/// One row, with the fixed id "current": there is exactly one live rate card,
/// and a known id makes reading it a single findUnique with no ordering to get
/// wrong. Past rates are deliberately not versioned here — a released cutoff is
/// already frozen in its Payslip snapshot, so history lives there.
model CrewRate {
  id          String   @id @default("current")
  /// Guaranteed daily minimum for a driver, paid when piece-rate falls short.
  driverDaily Decimal  @default(280) @db.Decimal(12, 2)
  /// The same, for a pahinante.
  helperDaily Decimal  @default(240) @db.Decimal(12, 2)
  /// "Palima" bonus, paid per head once a truck clears the trip threshold.
  bonusHead   Decimal  @default(100) @db.Decimal(12, 2)
  /// Trips one truck must finish in a day before the bonus applies.
  bonusTrips  Int      @default(5)

  updatedAt   DateTime @updatedAt

  @@map("crew_rates")
}

/// Barangay / sitio names that qualify for double rates.
model DoubleRateArea {
  id       String  @id @default(cuid())
  areaName String  @unique
  isActive Boolean @default(true)

  @@map("double_rate_areas")
}

// ============================================================================
// LOANS & ADVANCES
// ============================================================================

/// A loan or cash advance (bale).
///
/// There is no `balance` column by design. The outstanding amount is derived
/// by summing this loan's ledger entries, so the number on screen can always
/// be traced to dated events. The client's stated problem was employees
/// questioning their balances; a computed balance can be explained line by
/// line, a stored one cannot.
model Loan {
  id           String      @id @default(cuid())
  employeeId   String
  type         LoanType    @default(CASH_ADVANCE)
  principal    Decimal     @db.Decimal(12, 2)
  dateGranted  DateTime    @db.Date

  /// Amount withheld each payroll run. Office staff are deducted per cutoff;
  /// drivers are deducted in smaller daily increments so a single payday
  /// isn't wiped out.
  deductionPerRun Decimal  @default(0) @db.Decimal(12, 2)
  /// "Option not to pay" — pauses deductions without deleting the loan.
  isPaused     Boolean     @default(false)
  isSettled    Boolean     @default(false)
  settledAt    DateTime?
  note         String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries      LoanEntry[]

  @@index([employeeId])
  @@map("loans")
}

/// Dated, typed ledger events. Balance = sum(GRANT) − sum(DEDUCTION).
/// Rows are append-only: a correction is a new entry, never an edit, so the
/// history stays auditable.
model LoanEntry {
  id        String          @id @default(cuid())
  loanId    String
  date      DateTime        @db.Date
  type      LedgerEntryType
  amount    Decimal         @db.Decimal(12, 2)
  note      String?
  /// Set when the entry was written by a payroll run rather than by hand.
  payslipId String?
  createdAt DateTime        @default(now())

  loan      Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, date])
  @@map("loan_entries")
}

// ============================================================================
// STATUTORY TABLES — all admin-editable, all versioned by year
// ============================================================================
// Government rates change annually. Every table carries an effectivity year
// so a payslip computed in 2026 can still be reproduced after the 2027 tables
// are entered.

model SssBracket {
  id             String  @id @default(cuid())
  effectiveYear  Int
  salaryFrom     Decimal @db.Decimal(12, 2)
  salaryTo       Decimal @db.Decimal(12, 2)
  employeeShare  Decimal @db.Decimal(12, 2)
  employerShare  Decimal @default(0) @db.Decimal(12, 2)

  @@index([effectiveYear])
  @@map("sss_brackets")
}

model PhilhealthConfig {
  id            String  @id @default(cuid())
  effectiveYear Int     @unique
  ratePercent   Decimal @db.Decimal(5, 2) // e.g. 5.00
  salaryFloor   Decimal @db.Decimal(12, 2) // e.g. 10,000
  salaryCeiling Decimal @db.Decimal(12, 2) // e.g. 100,000

  @@map("philhealth_config")
}

/// Pag-IBIG is a percentage of salary by bracket, capped at a monthly maximum.
/// In practice every Prime Depot employee earns above the second bracket, so
/// they all pay the cap — but the bracket structure is stored rather than the
/// flat amount, so the table stays correct if HDMF changes the rule.
model PagibigConfig {
  id             String           @id @default(cuid())
  effectiveYear  Int              @unique
  monthlyCap     Decimal          @db.Decimal(12, 2) // e.g. 200
  brackets       PagibigBracket[]

  @@map("pagibig_config")
}

model PagibigBracket {
  id              String        @id @default(cuid())
  configId        String
  salaryUpTo      Decimal?      @db.Decimal(12, 2) // null = no upper bound
  employeePercent Decimal       @db.Decimal(5, 2)
  employerPercent Decimal       @default(0) @db.Decimal(5, 2)

  config          PagibigConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@map("pagibig_brackets")
}

/// Withholding tax brackets. Employees at or below the exemption threshold
/// compute to zero, but the line still appears on the payslip — the client
/// wants the field present for correct formatting.
model BirBracket {
  id             String  @id @default(cuid())
  effectiveYear  Int
  incomeFrom     Decimal @db.Decimal(12, 2)
  incomeTo       Decimal? @db.Decimal(12, 2) // null = no upper bound
  baseTax        Decimal @db.Decimal(12, 2)
  percentOverExcess Decimal @db.Decimal(5, 2)

  @@index([effectiveYear])
  @@map("bir_brackets")
}

// ============================================================================
// PAYROLL RUNS
// ============================================================================

/// A semi-monthly cutoff (1–15, 16–end). Statutory contributions are halved
/// across the two runs in a month.
model PayrollPeriod {
  id          String      @id @default(cuid())
  label       String // e.g. "May 16–31, 2026"
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  isReleased  Boolean     @default(false)
  releasedAt  DateTime?
  createdAt   DateTime    @default(now())

  payslips    Payslip[]

  @@unique([startDate, endDate])
  @@map("payroll_periods")
}

/// A computed payslip, stored as a snapshot rather than recalculated on
/// demand. Once a period is released, its figures must stay fixed even if
/// rates, statutory tables, or employee records change afterwards — that is
/// what makes the payroll history trustworthy.
model Payslip {
  id              String      @id @default(cuid())
  payrollPeriodId String
  employeeId      String
  payrollType     PayrollType

  daysPresent     Int         @default(0)
  basicPay        Decimal     @default(0) @db.Decimal(12, 2)
  overtimeWeekday Decimal     @default(0) @db.Decimal(12, 2)
  overtimeWeekend Decimal     @default(0) @db.Decimal(12, 2)
  allowances      Decimal     @default(0) @db.Decimal(12, 2)

  // Pakyawan components — zero for office staff.
  pieceRateTotal  Decimal     @default(0) @db.Decimal(12, 2)
  palimaBonus     Decimal     @default(0) @db.Decimal(12, 2)
  tripCount       Int         @default(0)

  grossPay        Decimal     @default(0) @db.Decimal(12, 2)

  sssDeduction        Decimal @default(0) @db.Decimal(12, 2)
  philhealthDeduction Decimal @default(0) @db.Decimal(12, 2)
  pagibigDeduction    Decimal @default(0) @db.Decimal(12, 2)
  mp2Deduction        Decimal @default(0) @db.Decimal(12, 2)
  withholdingTax      Decimal @default(0) @db.Decimal(12, 2)
  loanDeduction       Decimal @default(0) @db.Decimal(12, 2)
  tardinessDeduction  Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions     Decimal @default(0) @db.Decimal(12, 2)

  totalDeductions Decimal     @default(0) @db.Decimal(12, 2)
  netPay          Decimal     @default(0) @db.Decimal(12, 2)
  remarks         String?

  createdAt       DateTime    @default(now())

  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}
